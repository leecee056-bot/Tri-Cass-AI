{
  "name": "tri-cass-ai",
  "version": "0.1.4",
  "private": false,
  "description": "Tri Cass AI \u2014 standalone local coding assistant for household PCs",
  "main": "./out/main/index.js",
  "author": "Lee Cee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leecee056-bot/Tri-Cass-AI.git"
  },
  "homepage": "https://github.com/leecee056-bot/Tri-Cass-AI#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "smoke": "tsx scripts/smoke.ts",
    "test:unit": "tsx scripts/unit-agent-tools.ts && tsx scripts/unit-agent-loop.ts && tsx scripts/unit-agent-plan-search.ts && tsx scripts/unit-kb-chat.ts && tsx scripts/unit-project-run.ts && tsx scripts/unit-scaffold-coherence.ts",
    "test:scaffold": "tsx scripts/unit-scaffold-coherence.ts",
    "smoke:create": "tsx scripts/smoke-create-website.ts",
    "test:loop": "tsx scripts/unit-agent-loop.ts",
    "test:plan": "tsx scripts/unit-agent-plan-search.ts",
    "test:kb": "tsx scripts/unit-kb-chat.ts",
    "test:run": "tsx scripts/unit-project-run.ts",
    "evidence:v4": "tsx scripts/evidence-v4.ts",
    "pack:win": "npm run build && electron-builder --win nsis portable",
    "pack:win:dir": "npm run build && electron-builder --win --dir",
    "pack:linux:dir": "npm run build && electron-builder --linux --dir"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/orbitron": "^5.2.5",
    "figlet": "^1.13.0",
    "marked": "^18.3.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tar": "^7.5.24",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3"
  },
  "build": {
    "appId": "ai.tricass.local",
    "productName": "Tri Cass AI",
    "copyright": "Copyright \u00a9 Tri-Cass",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/textures/**/*",
      "build/brand/**/*",
      "build/icons/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/textures",
        "to": "textures"
      },
      {
        "from": "build/brand",
        "to": "brand"
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Tri-Cass-AI-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tri Cass AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "artifactName": "Tri-Cass-AI-${version}-${os}-${arch}.${ext}"
    }
  }
}
